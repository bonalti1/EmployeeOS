# Copy to .env for local development with `netlify dev`, OR set these in the
# Netlify dashboard under Site settings → Environment variables.
# The app runs fully offline without any of these — add them when you connect
# a service (see Settings → Integrations in the app).

# Optional — cloud transcription & AI summaries for the Journal, and the
# Assistant Workspace AI Studio (same key powers both;
# kept secret server-side, never exposed to the browser):
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Optional — Marketing Studio model overrides (defaults shown):
# MARKETING_MODEL=gpt-4o
# MARKETING_IMAGE_MODEL=gpt-image-1
# Set only when a video vendor is chosen (see MARKETING_STUDIO_SETUP.md):
# MARKETING_VIDEO_PROVIDER=

# Optional — Google Calendar two-way sync:
# GOOGLE_CLIENT_ID=...

# Optional — Plaid for live bank balances:
# PLAID_CLIENT_ID=...
# PLAID_SECRET=...

# Optional — web push reminders to your phone:
# VAPID_PUBLIC_KEY=...
